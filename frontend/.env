# Frontend environment variables
# These are baked in at build time by Vite (prefix with VITE_ to expose to client code)

# URL of the Python backend API
VITE_API_BASE_URL=http://localhost:8000

# App display name (used in meta / title if referenced via import.meta.env)
VITE_APP_NAME=PDF Signer

# Port the dev server listens on (used in vite.config.ts)
VITE_PORT=5173
